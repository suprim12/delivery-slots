{% extends '_layouts/cp' %}

{% set title = 'Delivery time'|t('delivery-slots') %}
{% set crumbs = [
	{ label: 'Orders'|t('commerce'), url: url('commerce/orders') },
	{ label: order.reference ?: order.shortNumber, url: order.cpEditUrl },
] %}

{% block toolbar %}
	{% if schedule %}
		<div class="flex">
			<div class="btngroup">
				<a class="btn" href="{{ url('delivery-slots/orders/' ~ order.id, { date: prev }) }}" aria-label="{{ 'Previous day'|t('delivery-slots') }}" data-icon="leftangle"></a>
				<a class="btn" href="{{ url('delivery-slots/orders/' ~ order.id, { date: now|date('Y-m-d') }) }}">{{ 'Today'|t('delivery-slots') }}</a>
				<a class="btn" href="{{ url('delivery-slots/orders/' ~ order.id, { date: next }) }}" aria-label="{{ 'Next day'|t('delivery-slots') }}" data-icon="rightangle"></a>
			</div>
			<h2 style="margin: 0 12px;">{{ date|date('l j F Y') }}</h2>
		</div>
	{% endif %}
{% endblock %}

{% block content %}
	<p>
		{{ 'Order'|t('delivery-slots') }} <a href="{{ order.cpEditUrl }}">{{ order.reference ?: order.shortNumber }}</a>
		· {{ method ? method.name : 'No shipping method'|t('delivery-slots') }}
		· {% if current %}{{ 'Now:'|t('delivery-slots') }} <strong>{{ current.label }}</strong>{% else %}{{ 'No delivery time yet'|t('delivery-slots') }}{% endif %}
	</p>

	{% if not schedule %}
		<p class="zilch">{{ 'This order’s shipping method has no delivery times.'|t('delivery-slots') }}</p>
	{% elseif not windows|length %}
		<p class="zilch">{{ 'No time windows run on this day.'|t('delivery-slots') }}</p>
	{% else %}
		{% if closedLabel %}<p class="warning with-icon">{{ 'This day is closed for customers ({label}). You can still choose a time.'|t('delivery-slots', { label: closedLabel }) }}</p>{% endif %}
		<table class="data fullwidth">
			<thead>
				<tr>
					<th scope="col">{{ 'Time'|t('delivery-slots') }}</th>
					<th scope="col">{{ 'Orders'|t('delivery-slots') }}</th>
					<th scope="col"></th>
				</tr>
			</thead>
			<tbody>
				{% for w in windows %}
					<tr>
						<th scope="row">{{ w.label }}{% if w.current %} <span class="status green" style="margin-left: 8px;"></span>{{ 'Current'|t('delivery-slots') }}{% endif %}</th>
						<td>
							{% if w.closed %}
								<span class="light">{{ 'Closed for customers on this day'|t('delivery-slots') }}</span>
							{% else %}
								{{ w.taken }} / {{ w.capacity }}{% if w.taken >= w.capacity %} <span class="light">· {{ 'Full'|t('delivery-slots') }}</span>{% endif %}
							{% endif %}
						</td>
						<td class="thin">
							{% if not w.current %}
								<form method="post">
									{{ csrfInput() }}
									{{ actionInput('delivery-slots/orders/save') }}
									{{ redirectInput(order.cpEditUrl) }}
									{{ hiddenInput('orderId', order.id) }}
									{{ hiddenInput('date', date|date('Y-m-d')) }}
									{{ hiddenInput('start', w.start) }}
									<button type="submit" class="btn small">{{ current ? 'Move here'|t('delivery-slots') : 'Choose'|t('delivery-slots') }}</button>
								</form>
							{% endif %}
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
		<p class="light">{{ 'Staff can choose any time, even when it’s full or closed for customers. The customer isn’t emailed about the change.'|t('delivery-slots') }}</p>
	{% endif %}

	{% if current %}
		<hr>
		<form method="post">
			{{ csrfInput() }}
			{{ actionInput('delivery-slots/orders/save') }}
			{{ redirectInput(order.cpEditUrl) }}
			{{ hiddenInput('orderId', order.id) }}
			{{ hiddenInput('remove', '1') }}
			<button type="submit" class="btn">{{ 'Remove the delivery time'|t('delivery-slots') }}</button>
		</form>
	{% endif %}
{% endblock %}
