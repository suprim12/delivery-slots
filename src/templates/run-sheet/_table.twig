{# The run sheet's orders, by slot. Used by the control panel page and the print view. #}
{% if groups|length %}
	<table class="data fullwidth ds-sheet">
		<thead>
			<tr>
				<th scope="col">{{ 'Order'|t('delivery-slots') }}</th>
				<th scope="col">{{ 'Customer'|t('delivery-slots') }}</th>
				<th scope="col">{{ 'Address'|t('delivery-slots') }}</th>
				<th scope="col">{{ 'Zone'|t('delivery-slots') }}</th>
				<th scope="col">{{ 'Items'|t('delivery-slots') }}</th>
				{% if showNote %}<th scope="col">{{ 'Note'|t('delivery-slots') }}</th>{% endif %}
			</tr>
		</thead>
		{% for group in groups %}
			<tbody class="ds-group">
				<tr class="ds-group-head">
					<th scope="rowgroup" colspan="{{ showNote ? 6 : 5 }}">{{ group.label }} <span class="light">· {{ '{count, plural, =1{# order} other{# orders}}'|t('delivery-slots', { count: group.rows|length }) }}</span></th>
				</tr>
				{% for row in group.rows %}
					<tr>
						<td>{% if printView ?? false %}{{ row.reference }}{% else %}<a href="{{ row.order.cpEditUrl }}">{{ row.reference }}</a>{% endif %}</td>
						<td>{{ row.name }}{% if row.phone or row.email %}<div class="light smalltext">{{ row.phone ?: row.email }}</div>{% endif %}</td>
						<td>{{ row.address }}{% if row.locality %}, {{ row.locality }}{% endif %}{% if row.postcode %} {{ row.postcode }}{% endif %}</td>
						<td>{{ row.zone ?: '—' }}</td>
						<td>{{ row.items }}</td>
						{% if showNote %}<td>{{ row.note }}</td>{% endif %}
					</tr>
				{% endfor %}
			</tbody>
		{% endfor %}
	</table>
{% else %}
	<p class="zilch">{{ 'No orders booked for this day.'|t('delivery-slots') }}</p>
{% endif %}
