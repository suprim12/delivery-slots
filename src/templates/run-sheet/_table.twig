{# The run sheet's orders, by slot. Used by the control panel page and the print view. #}
{% if groups|length %}
	<table class="data fullwidth ds-sheet">
		<thead>
			<tr>
				<th scope="col">{{ 'Order'|t('delivery-slots') }}</th>
				<th scope="col">{{ 'Customer'|t('delivery-slots') }}</th>
				<th scope="col">{{ 'Address'|t('delivery-slots') }}</th>
				<th scope="col">{{ 'Zone'|t('delivery-slots') }}</th>
				<th scope="col">{{ 'Items'|t('delivery-slots') }}</th>
				{% if showNote %}<th scope="col">{{ 'Note'|t('delivery-slots') }}</th>{% endif %}
				<th scope="col">{{ 'Status'|t('delivery-slots') }}</th>
			</tr>
		</thead>
		{% for group in groups %}
			<tbody class="ds-group">
				<tr class="ds-group-head">
					<th scope="rowgroup" colspan="{{ showNote ? 7 : 6 }}">{{ group.label }} <span class="light">· {{ '{count, plural, =1{# order} other{# orders}}'|t('delivery-slots', { count: group.rows|length }) }}</span></th>
				</tr>
				{% for row in group.rows %}
					<tr>
						<td>{% if printView ?? false %}{{ row.reference }}{% else %}<a href="{{ row.order.cpEditUrl }}">{{ row.reference }}</a>{% endif %}</td>
						<td>{{ row.name }}{% if row.asap %} <span class="light smalltext">· {{ 'As soon as possible'|t('delivery-slots') }}</span>{% endif %}{% if row.phone or row.email %}<div class="light smalltext">{{ row.phone ?: row.email }}</div>{% endif %}</td>
						<td>{{ row.address }}{% if row.locality %}, {{ row.locality }}{% endif %}{% if row.postcode %} {{ row.postcode }}{% endif %}</td>
						<td>{{ row.zone ?: '—' }}</td>
						<td>{{ row.items }}</td>
						{% if showNote %}<td>{{ row.note }}</td>{% endif %}
						<td class="nowrap">
							{% if row.status %}<span class="status {{ row.status.color }}"></span>{{ row.status.displayName ?? row.status.name }}{% endif %}
							{% if (canMarkDelivered ?? false) and not (printView ?? false) and not row.delivered %}
								<form method="post" style="display: inline-block; margin-left: 8px;">
									{{ csrfInput() }}
									{{ actionInput('delivery-slots/run-sheet/mark-delivered') }}
									{{ redirectInput(craft.app.request.url) }}
									{{ hiddenInput('orderId', row.order.id) }}
									<button type="submit" class="btn small">{{ 'Mark delivered'|t('delivery-slots') }}</button>
								</form>
							{% endif %}
						</td>
					</tr>
				{% endfor %}
			</tbody>
		{% endfor %}
	</table>
{% else %}
	<p class="zilch">{{ 'No orders booked for this day.'|t('delivery-slots') }}</p>
{% endif %}
