<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
<head>
	<meta charset="utf-8">
	<title>{{ sheetView == 'packing' ? 'Packing list'|t('delivery-slots') : 'Run sheet'|t('delivery-slots') }} · {{ date|date('l j F Y') }}</title>
	<style>
		body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; color: #1f2933; margin: 24px; font-size: 12pt; }
		h1 { font-size: 18pt; margin: 0 0 4px; }
		p.meta { margin: 0 0 16px; color: #52606d; }
		table { width: 100%; border-collapse: collapse; }
		th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #d6dee8; vertical-align: top; }
		thead th { font-size: 10pt; color: #52606d; }
		.ds-group-head th { background: #eef2f7; font-size: 12pt; }
		.light { color: #52606d; font-weight: normal; }
		.smalltext { font-size: 10pt; }
		.zilch { color: #52606d; }
		.ds-num { text-align: right; white-space: nowrap; }
		@media print {
			body { margin: 0; }
			.ds-group { break-before: page; }
			.ds-group:first-of-type { break-before: auto; }
			thead { display: table-header-group; }
			.noprint { display: none; }
		}
	</style>
</head>
<body>
	<h1>{{ sheetView == 'packing' ? 'Packing list'|t('delivery-slots') : 'Run sheet'|t('delivery-slots') }} · {{ date|date('l j F Y') }}</h1>
	<p class="meta">{{ methodId ? methods[methodId].name : 'All shipping methods'|t('delivery-slots') }} · {{ '{count, plural, =1{# order} other{# orders}}'|t('delivery-slots', { count: total }) }}</p>
	{% if sheetView == 'packing' %}
		{% include 'delivery-slots/run-sheet/_packing' %}
	{% else %}
		{% include 'delivery-slots/run-sheet/_table' with { printView: true } %}
	{% endif %}
	<script>window.addEventListener('load', function () { window.print(); });</script>
</body>
</html>
