<div class="meta read-only" style="margin-top: var(--m, 14px);">
	<div class="data">
		<h5 class="heading">{{ slot and not slot.isBooked ? 'Delivery time (held)'|t('delivery-slots') : 'Delivery time'|t('delivery-slots') }}</h5>
		<div class="value" style="display: block;">
			<div>{{ slot ? slot.label : '—' }}</div>
			{% if slot and slot.asap %}<div class="light">{{ 'Asked for as soon as possible'|t('delivery-slots') }}</div>{% endif %}
			{% if canEdit %}<div style="margin-top: 4px;"><a href="{{ url('delivery-slots/orders/' ~ order.id) }}">{{ slot ? 'Change'|t('delivery-slots') : 'Choose a time'|t('delivery-slots') }}</a></div>{% endif %}
		</div>
	</div>
	{% set zoneName = slot ? slot.zoneName : null %}
	{% if zoneName %}
		<div class="data">
			<h5 class="heading">{{ 'Zone'|t('delivery-slots') }}</h5>
			<div class="value">{{ zoneName }}</div>
		</div>
	{% endif %}
</div>
