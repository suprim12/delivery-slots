{# The built-in email for a changed delivery time. Override it with `slotChangedTemplate` in config/delivery-slots.php. #}
<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
<head><meta charset="utf-8"><title>{{ subject }}</title></head>
<body style="margin: 0; padding: 24px; background: #f4f4f1; font-family: Arial, Helvetica, sans-serif; color: #1c1d1f;">
	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 560px; margin: 0 auto; background: #ffffff; border-radius: 8px;">
		<tr>
			<td style="padding: 28px 32px;">
				<p style="margin: 0 0 16px; font-size: 20px; font-weight: bold;">{{ 'Your order has a new time'|t('delivery-slots') }}</p>
				<p style="margin: 0 0 20px; font-size: 15px; line-height: 1.5;">{{ 'We’ve moved your {method} for order {reference}.'|t('delivery-slots', { method: (order.shippingMethod.name ?? 'delivery')|lower, reference: order.reference ?: order.shortNumber }) }}</p>
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background: #eef4ef; border-radius: 8px;">
					<tr>
						<td style="padding: 16px 20px;">
							<p style="margin: 0 0 4px; font-size: 13px; color: #4a5048;">{{ 'New time'|t('delivery-slots') }}</p>
							<p style="margin: 0; font-size: 18px; font-weight: bold;">{{ slot.label }}</p>
							{% if previousSlot %}
								<p style="margin: 8px 0 0; font-size: 13px; color: #4a5048;">{{ 'Was {time}'|t('delivery-slots', { time: previousSlot.label }) }}</p>
							{% endif %}
						</td>
					</tr>
				</table>
				{% if order.shippingAddress %}
					<p style="margin: 20px 0 0; font-size: 15px; line-height: 1.5;">{{ 'To {address}.'|t('delivery-slots', { address: [order.shippingAddress.addressLine1, order.shippingAddress.locality]|filter|join(', ') }) }}</p>
				{% endif %}
				{% if slot.calendarUrl %}
					<p style="margin: 20px 0 0; font-size: 15px;"><a href="{{ slot.calendarUrl }}" style="color: #1f5f3f;">{{ 'Add to calendar'|t('delivery-slots') }}</a></p>
				{% endif %}
				<p style="margin: 24px 0 0; font-size: 13px; color: #4a5048;">{{ 'Questions? Reply to this email.'|t('delivery-slots') }}</p>
			</td>
		</tr>
	</table>
</body>
</html>
